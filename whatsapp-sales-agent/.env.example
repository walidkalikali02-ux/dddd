# انسخ الملف ده باسم .env واملأ القيم

# ---------- Claude ----------
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5
# low / medium / high  (medium مناسب للمحادثات)
CLAUDE_EFFORT=medium

# ---------- بياناتك ----------
# كود الدولة للأرقام المكتوبة في اللستة من غير كود (مصر 20، السودان 249، السعودية 966، الإمارات 971)
DEFAULT_COUNTRY_CODE=20
# (اختياري) رقم تاني ليك يوصله تنبيهات العملاء السخنين على واتساب. التنبيهات بتظهر في الداشبورد في كل الأحوال
OWNER_PHONE=
BUSINESS_PROFILE=business_profile.md
TIMEZONE=Africa/Cairo

# ---------- الإرسال (خليك محافظ عشان رقمك ميتحظرش) ----------
# الايجنت يبدأ محادثات ويتابع بس في الساعات دي (الرد على اللي بيبعتلك في أي وقت)
SEND_HOUR_START=10
SEND_HOUR_END=20
# أقصى عدد عملاء جدد يتبعتلهم في اليوم. ابدأ بـ 10-20 وزوّد بالتدريج
MAX_NEW_CONTACTS_PER_DAY=20
MAX_FOLLOWUPS=3
# أقل عدد أيام بين كل متابعة والتانية لو العميل مردش
FOLLOWUP_GAP_DAYS=2,4,7
# انتظار عشوائي بين كل رسالة والتانية (بالثواني)
MIN_SECONDS_BETWEEN_SENDS=45
MAX_SECONDS_BETWEEN_SENDS=120
REPLY_DEBOUNCE_SECONDS=8
SCHEDULER_INTERVAL_MINUTES=10

# false = الايجنت يرد بس على الناس اللي في لستة العملاء (مهم لو ده رقمك الشخصي)
REPLY_TO_UNKNOWN=false

# ---------- الربط بواتساب ويب ----------
BRIDGE_URL=http://127.0.0.1:3100
BRIDGE_AUTOSTART=true
# كلمة سر بين البرنامجين (أي كلام عشوائي)
BRIDGE_SECRET=change-me-123
# true = يشتغل من غير ما يفتح نافذة كروم (بعد ما تكون مسحت الـ QR)
BRIDGE_HEADLESS=false
# لو عندك Google Chrome وعاوز تستخدمه بدل اللي بيتسطب تلقائي، حط مساره هنا
CHROME_PATH=

# ---------- لوحة التحكم ----------
# لو حطيت كلمة سر، الداشبورد هيطلب (اسم المستخدم: admin)
ADMIN_PASSWORD=
